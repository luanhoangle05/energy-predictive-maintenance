# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables and local secrets
.env
.env.*
!.env.example

# Jupyter
.ipynb_checkpoints/

# Packaging and build output
build/
dist/
*.egg-info/

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp

# Project data (retain directory markers)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Generated model artifacts (retain directory marker)
models/*
!models/.gitkeep
*.pkl
*.pickle
*.joblib
*.onnx

# Generated figures (retain directory marker)
reports/figures/*
!reports/figures/.gitkeep

# NASA C-MAPSS raw dataset
data/raw/cmapss/*
!data/raw/cmapss/.gitkeep
